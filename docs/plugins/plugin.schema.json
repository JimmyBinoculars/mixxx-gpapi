{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "SPDX-License-Identifier: 0BSD. This file is part of the Mixxx plugin SDK and is licensed under the BSD Zero Clause License (0BSD); see docs/plugins/LICENSE. SCOPE: this permissive license applies ONLY to src/plugins/api/mixxx_plugin_abi.h, docs/plugins/mixxx.d.ts and docs/plugins/plugin.schema.json (this file). No other file is covered; the rest of the Mixxx source tree, including other files under src/plugins/, remains GPL-2.0-or-later.",
  "title": "Mixxx plugin manifest",
  "type": "object",
  "required": ["id", "name", "apiVersion", "entry"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "homepage": { "type": "string" },
    "apiVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "runtime": { "type": "string", "enum": ["script", "native"] },
    "entry": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "script": { "type": "string" },
            "native": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "controls.read",
          "controls.write",
          "ui.menu",
          "ui.panel",
          "network",
          "files.read",
          "files.write",
          "library.read",
          "library.write",
          "audio.graph",
          "download",
          "process.exec",
          "files.paths",
          "ui.web",
          "audio.scope",
          "library.remote"
        ]
      },
      "uniqueItems": true
    },
    "minMixxxVersion": { "type": "string" },
    "maxMixxxVersion": { "type": "string" }
  }
}
